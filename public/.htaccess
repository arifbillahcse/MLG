# php -- BEGIN cPanel-generated handler, do not edit
# Committed deliberately. cPanel's MultiPHP Manager writes this block here, and
# this file is tracked, so a git reset --hard removes it: the domain silently
# drops to the account default PHP, which on this host has no intl and takes the
# admin panel down. Keeping it in the repo is what stops that recurring.
#
# It is specific to cPanel with EA-PHP 8.2 — change or remove it when deploying
# anywhere else. The mime_module guard is how cPanel writes it: where that
# module is absent the block is skipped rather than breaking PHP entirely.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect trailing slashes if not a folder
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send requests to the front controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
