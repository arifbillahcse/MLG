APP_NAME="Multi Languages Gateway"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Phase 2 introduces the schema; Phase 1 touches no database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mlg
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Phase 5 wires the enquiry forms to this.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@mlg.com.bd"
MAIL_FROM_NAME="${APP_NAME}"

# Site-wide values the templates will read in Phase 4.
MLG_PHONE="+8801700000000"
MLG_WHATSAPP="8801700000000"
MLG_EMAIL="info@mlg.com.bd"
